{
  "kind": "collectionType",
  "collectionName": "evaluaciones",
  "info": {
    "singularName": "evaluacion",
    "pluralName": "evaluaciones",
    "displayName": "Evaluacion"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fechaEvaluacion": {
      "type": "date"
    },
