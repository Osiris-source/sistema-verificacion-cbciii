{
  "kind": "collectionType",
  "collectionName": "ambientes",
  "info": {
    "singularName": "ambiente",
    "pluralName": "ambientes",
    "displayName": "Ambiente"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "codigo": {
      "type": "string",
      "unique": true
    },
    "tipoAmbiente": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "AULA",
        "LABORATORIO",
        "PABELLON"
      ]
    },
    "piso": {
      "type": "string"
    },
    "ubicacion": {
      "type": "text"
    },
    "estado": {
      "type": "boolean",
      "default": true
    },
    "facultad": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::facultad.facultad",
      "inversedBy": "ambientes"
    },
    "escuela": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::escuela.escuela",
      "inversedBy": "ambientes"
    },
    "evaluaciones": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evaluacion.evaluacion",
      "mappedBy": "ambiente"
    }
  }
}
